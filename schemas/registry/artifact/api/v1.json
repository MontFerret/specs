{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ferretlang.org/registry/artifact/api/v1.json",
  "title": "Ferret Registry API Reference Artifact v1",
  "description": "The statically derived Ferret-facing API for one immutable module version.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "namespaces"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "https://schemas.ferretlang.org/common/identifier.json"
    },
    "version": {
      "$ref": "https://schemas.ferretlang.org/common/semver.json"
    },
    "namespaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/namespace"
      }
    }
  },
  "$defs": {
    "ferretIdentifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
    },
    "namespace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "functions"
      ],
      "properties": {
        "name": {
          "oneOf": [
            {
              "const": ""
            },
            {
              "$ref": "https://schemas.ferretlang.org/common/namespace.json"
            }
          ]
        },
        "functions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/function"
          }
        }
      }
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "signatures"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/ferretIdentifier"
        },
        "signatures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/signature"
          }
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parameters"
      ],
      "properties": {
        "parameters": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/parameterName"
          }
        },
        "variadic": {
          "const": true
        },
        "documentation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "parameterName": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    }
  }
}
