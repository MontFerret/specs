{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ferretlang.org/registry/artifact/api-index/v1.json",
  "title": "Ferret API Reference Index Artifact v1",
  "description": "Discovery metadata for immutable, versioned Ferret API Reference artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "versions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "latest": {
      "$ref": "https://schemas.ferretlang.org/common/semver.json"
    },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/version"
      }
    }
  },
  "$defs": {
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "href"
      ],
      "properties": {
        "version": {
          "$ref": "https://schemas.ferretlang.org/common/semver.json"
        },
        "href": {
          "type": "string",
          "minLength": 1,
          "format": "uri-reference",
          "pattern": "^[^?#\\r\\n]+$"
        }
      }
    }
  }
}
